# ==============================================================================
# Banco de Dados (Desenvolvimento Local)
# ==============================================================================
# Opção A (Atual / Recomendada sem Docker local): Supabase PostgreSQL 17 (Session Pooler IPv4, porta 5432, TLS)
# Salve a connection string localmente fora do Git com:
#   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "<STRING_ABAIXO>" --project src/Finance.Api
# Confira o host exato (aws-0-... ou aws-1-...) no painel Connect -> Session pooler do Supabase:
ConnectionStrings__DefaultConnection=Host=aws-0-sa-east-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<PROJECT_REF>;Password=<SUA_SENHA>;SSL Mode=Require;Maximum Pool Size=10

# Opção B (Opcional - PostgreSQL local via docker-compose.yml)
POSTGRES_DB=finance_db
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_dev_password
POSTGRES_PORT=5432
# ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=finance_db;Username=finance_user;Password=finance_dev_password

# ==============================================================================
# Segurança & API REST (.NET 10)
# ==============================================================================
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET_FOR_DEV_ONLY
ALLOWED_ORIGINS=http://localhost:5173

# ==============================================================================
# Bot do Telegram (Opcional - Modo Polling local ou Webhook em produção/VPS)
# ==============================================================================
# Crie um bot em @BotFather no Telegram e configure via user-secrets (local):
#   dotnet user-secrets set "Telegram:BotToken" "<TOKEN_DO_BOTFATHER>" --project src/Finance.Api
#   dotnet user-secrets set "Telegram:BotUsername" "<USERNAME_SEM_ARROBA>" --project src/Finance.Api
#   dotnet user-secrets set "Telegram:Mode" "Polling" --project src/Finance.Api
# Ou via variáveis de ambiente (Docker/VPS):
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Polling (dev local sem HTTPS) | Webhook (produção com HTTPS) | Disabled
TELEGRAM_MODE=Polling
# Segredo enviado no header X-Telegram-Bot-Api-Secret-Token quando TELEGRAM_MODE=Webhook
TELEGRAM_WEBHOOK_SECRET=
